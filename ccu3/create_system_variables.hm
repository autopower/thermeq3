! ==========================================================
!  Create system variables for TRV boiler control (run once)
!  CCU WebUI: Programs and connections -> Programs & CCU connection
!             -> Test script, paste this script and run it.
!  Existing variables are skipped (their values are not changed),
!  so it is safe to run it again after an update to add new variables.
! ==========================================================

object svList = dom.GetObject(ID_SYSTEM_VARIABLES);
object o;

! ---------- numbers: inputs ----------
if (svList.Get("TRV_Threshold_On")) { WriteLine("exists: TRV_Threshold_On"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Threshold_On"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(0); o.ValueMax(100); o.ValueUnit("%");
  o.DPInfo("HAHM Boiler ON when at least TRV_Min_Count valves or rooms are open >= this value (%)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(30);
  WriteLine("created: TRV_Threshold_On");
}
if (svList.Get("TRV_Threshold_Off")) { WriteLine("exists: TRV_Threshold_Off"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Threshold_Off"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(0); o.ValueMax(100); o.ValueUnit("%");
  o.DPInfo("HAHM Boiler OFF when fewer than TRV_Min_Count valves or rooms are open > this value (%)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(25);
  WriteLine("created: TRV_Threshold_Off");
}
if (svList.Get("TRV_Min_Count")) { WriteLine("exists: TRV_Min_Count"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Min_Count"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(1); o.ValueMax(10); o.ValueUnit("");
  o.DPInfo("HAHM Minimum number of open valves or rooms required to run the boiler");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(2);
  WriteLine("created: TRV_Min_Count");
}
if (svList.Get("TRV_SVPNMW")) { WriteLine("exists: TRV_SVPNMW"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_SVPNMW"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(0); o.ValueMax(100); o.ValueUnit("%");
  o.DPInfo("HAHM Single valve position no matter what: boiler ON when any valve >= this (%), 0 = disabled");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(75);
  WriteLine("created: TRV_SVPNMW");
}
if (svList.Get("TRV_Summer_Temp")) { WriteLine("exists: TRV_Summer_Temp"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Summer_Temp"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(5); o.ValueMax(30); o.ValueUnit("°C");
  o.DPInfo("HAHM Summer mode Auto: heating blocked when outdoor temperature is above this value");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(15);
  WriteLine("created: TRV_Summer_Temp");
}
if (svList.Get("TRV_Summer_Delay")) { WriteLine("exists: TRV_Summer_Delay"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Summer_Delay"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(0); o.ValueMax(1440); o.ValueUnit("min");
  o.DPInfo("HAHM Summer mode Auto: minutes the outdoor condition must last before switching");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(60);
  WriteLine("created: TRV_Summer_Delay");
}
if (svList.Get("TRV_Outdoor_Temp")) { WriteLine("exists: TRV_Outdoor_Temp"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Outdoor_Temp"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(-50); o.ValueMax(60); o.ValueUnit("°C");
  o.DPInfo("HAHM Outdoor temperature, written periodically by Home Assistant");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(0);
  WriteLine("created: TRV_Outdoor_Temp");
}
if (svList.Get("TRV_Vent_Rooms")) { WriteLine("exists: TRV_Vent_Rooms"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Vent_Rooms"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(0); o.ValueMax(20); o.ValueUnit("");
  o.DPInfo("HAHM Number of rooms with an open window that means ventilating, 0 = disabled");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(3);
  WriteLine("created: TRV_Vent_Rooms");
}

! ---------- numbers: outputs ----------
if (svList.Get("TRV_Count")) { WriteLine("exists: TRV_Count"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Count"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(0); o.ValueMax(50); o.ValueUnit("");
  o.DPInfo("Number of TRVs in TRV_List (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(0);
  WriteLine("created: TRV_Count");
}
if (svList.Get("TRV_Max_Level")) { WriteLine("exists: TRV_Max_Level"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Max_Level"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(0); o.ValueMax(100); o.ValueUnit("%");
  o.DPInfo("Most open reachable TRV valve (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(0);
  WriteLine("created: TRV_Max_Level");
}
if (svList.Get("TRV_Open_Rooms")) { WriteLine("exists: TRV_Open_Rooms"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Open_Rooms"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(0); o.ValueMax(50); o.ValueUnit("");
  o.DPInfo("Number of rooms with an open window (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(0);
  WriteLine("created: TRV_Open_Rooms");
}
if (svList.Get("TRV_Script_RunsToday")) { WriteLine("exists: TRV_Script_RunsToday"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Script_RunsToday"); svList.Add(o.ID());
  o.ValueType(ivtFloat); o.ValueSubType(istGeneric);
  o.ValueMin(0); o.ValueMax(1000); o.ValueUnit("");
  o.DPInfo("Boiler script runs today, reset at midnight (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(0);
  WriteLine("created: TRV_Script_RunsToday");
}

! ---------- value lists: inputs ----------
if (svList.Get("TRV_Boiler_Control")) { WriteLine("exists: TRV_Boiler_Control"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Boiler_Control"); svList.Add(o.ID());
  o.ValueType(ivtInteger); o.ValueSubType(istEnum);
  o.ValueList("CCU;ESP;Manual");
  o.DPInfo("HAHM Who switches the boiler: CCU program, ESP thermostat, or Manual");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(0);
  WriteLine("created: TRV_Boiler_Control");
}
if (svList.Get("TRV_Count_Mode")) { WriteLine("exists: TRV_Count_Mode"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Count_Mode"); svList.Add(o.ID());
  o.ValueType(ivtInteger); o.ValueSubType(istEnum);
  o.ValueList("Valves;Rooms");
  o.DPInfo("HAHM Thresholds and Min_Count apply to single valves or to rooms (average of room valves)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(0);
  WriteLine("created: TRV_Count_Mode");
}
if (svList.Get("TRV_Summer_Mode")) { WriteLine("exists: TRV_Summer_Mode"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Summer_Mode"); svList.Add(o.ID());
  o.ValueType(ivtInteger); o.ValueSubType(istEnum);
  o.ValueList("Off;On;Auto");
  o.DPInfo("HAHM Summer mode: Off = heating allowed, On = heating blocked, Auto = by outdoor temperature");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(0);
  WriteLine("created: TRV_Summer_Mode");
}

! ---------- booleans: outputs ----------
if (svList.Get("TRV_Summer_Active")) { WriteLine("exists: TRV_Summer_Active"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Summer_Active"); svList.Add(o.ID());
  o.ValueType(ivtBinary); o.ValueSubType(istBool);
  o.ValueName0("no"); o.ValueName1("yes");
  o.DPInfo("Summer mode is active, heating blocked (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(false);
  WriteLine("created: TRV_Summer_Active");
}
if (svList.Get("TRV_Ventilating")) { WriteLine("exists: TRV_Ventilating"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Ventilating"); svList.Add(o.ID());
  o.ValueType(ivtBinary); o.ValueSubType(istBool);
  o.ValueName0("no"); o.ValueName1("yes");
  o.DPInfo("At least TRV_Vent_Rooms rooms have an open window (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State(false);
  WriteLine("created: TRV_Ventilating");
}

! ---------- strings: inputs ----------
if (svList.Get("TRV_Exclude")) { WriteLine("exists: TRV_Exclude"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Exclude"); svList.Add(o.ID());
  o.ValueType(ivtString); o.ValueSubType(istChar8859);
  o.DPInfo("HAHM TRV addresses to skip, separated by ;");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State("");
  WriteLine("created: TRV_Exclude");
}

! ---------- strings: outputs ----------
if (svList.Get("TRV_List")) { WriteLine("exists: TRV_List"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_List"); svList.Add(o.ID());
  o.ValueType(ivtString); o.ValueSubType(istChar8859);
  o.DPInfo("TRV addresses separated by ; (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State("");
  WriteLine("created: TRV_List");
}
if (svList.Get("TRV_List_Changed")) { WriteLine("exists: TRV_List_Changed"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_List_Changed"); svList.Add(o.ID());
  o.ValueType(ivtString); o.ValueSubType(istChar8859);
  o.DPInfo("Time of last TRV_List change (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State("");
  WriteLine("created: TRV_List_Changed");
}
if (svList.Get("TRV_Control_Active")) { WriteLine("exists: TRV_Control_Active"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Control_Active"); svList.Add(o.ID());
  o.ValueType(ivtString); o.ValueSubType(istChar8859);
  o.DPInfo("Who actually switches the boiler now, incl. fallback (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State("");
  WriteLine("created: TRV_Control_Active");
}
if (svList.Get("TRV_Demand_Rooms")) { WriteLine("exists: TRV_Demand_Rooms"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Demand_Rooms"); svList.Add(o.ID());
  o.ValueType(ivtString); o.ValueSubType(istChar8859);
  o.DPInfo("Valves or rooms at or above TRV_Threshold_On (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State("");
  WriteLine("created: TRV_Demand_Rooms");
}
if (svList.Get("TRV_Summer_Pending")) { WriteLine("exists: TRV_Summer_Pending"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Summer_Pending"); svList.Add(o.ID());
  o.ValueType(ivtString); o.ValueSubType(istChar8859);
  o.DPInfo("Summer mode Auto: time since a change is waiting for TRV_Summer_Delay, empty = none (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State("");
  WriteLine("created: TRV_Summer_Pending");
}
if (svList.Get("TRV_Config_Warnings")) { WriteLine("exists: TRV_Config_Warnings"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Config_Warnings"); svList.Add(o.ID());
  o.ValueType(ivtString); o.ValueSubType(istChar8859);
  o.DPInfo("Configuration warnings, empty = OK (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State("");
  WriteLine("created: TRV_Config_Warnings");
}
if (svList.Get("TRV_ESP_LastSeen")) { WriteLine("exists: TRV_ESP_LastSeen"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_ESP_LastSeen"); svList.Add(o.ID());
  o.ValueType(ivtString); o.ValueSubType(istChar8859);
  o.DPInfo("Time of last ESP thermostat poll, written by ESP (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State("");
  WriteLine("created: TRV_ESP_LastSeen");
}
if (svList.Get("TRV_Script_LastRun")) { WriteLine("exists: TRV_Script_LastRun"); } else {
  o = dom.CreateObject(OT_VARDP); o.Name("TRV_Script_LastRun"); svList.Add(o.ID());
  o.ValueType(ivtString); o.ValueSubType(istChar8859);
  o.DPInfo("Time of last boiler script run (output)");
  o.Internal(false); o.Visible(true); o.DPArchive(false); o.State("");
  WriteLine("created: TRV_Script_LastRun");
}

dom.RTUpdate(0);
WriteLine("done");
